@inject NavigationManager NavigationManager
@inject IUserServices UserServices



<div class="offcanvas offcanvas-end show" tabindex="-1"
     style="visibility: visible; position: absolute; top: 0; right: 0; width: 350px; z-index: 1040;">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">Perfil de Usuario</h5>
        <button type="button" class="btn-close" @onclick="OnClose"></button>
    </div>

    <div class="offcanvas-body d-flex flex-column align-items-center text-center">
        <!-- Imagen circular simulando foto -->
        <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center mb-3"
             style="width: 100px; height: 100px; font-size: 2rem; color: white;">
            <i class="bi bi-person-fill"></i> <!-- Icono Bootstrap -->
        </div>

        <!-- Datos del usuario -->
        <h5 class="fw-bold">@user?.Name</h5>
        <p class="text-muted">@user?.Email</p>
        <span class="badge bg-primary">@user?.Role</span>

        <!-- Botón Sign Out -->
        <button class="btn btn-danger mt-4 w-50" @onclick="Logout">Sign Out</button>
    </div>
</div>

@code {

    [Parameter] public string UserId { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private User? user;

    protected override async Task OnInitializedAsync()
    {
        if (IsOpen && !string.IsNullOrEmpty(UserId))
        {
            var response = await UserServices.GetMyUserAsync(UserId);
            if (response.Success)
            {
                user = response.Data;
            }
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task Logout()
    {
        NavigationManager.NavigateTo("/logout");
        await Close();
    }

}
