@using System.IdentityModel.Tokens.Jwt
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@inject CustomAuthStateProvider AuthStateProvider

<div>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary px-3">
        <a class="navbar-brand fw-bold" href="/">MiSistema</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <AuthorizeView Roles="Patient">
                    <li class="nav-item">
                        <NavLink class="btn btn-outline-light me-2" href="/cliente/miscitas">Agendar cita</NavLink>
                        <NavLink class="btn btn-outline-light me-2" href="/">Home</NavLink>

                    </li>
                </AuthorizeView>

                <AuthorizeView Roles="Doctor">
                    <li class="nav-item">
                        <NavLink class="btn btn-outline-light me-2" href="/doctor/citas">Citas</NavLink>
                        <NavLink class="btn btn-outline-light me-2" href="/">Home</NavLink>
                      
                    </li>
                </AuthorizeView>

                <AuthorizeView Roles="Admin">
                    <li class="nav-item">
                        <NavLink class="btn btn-outline-light me-2" href="/admin/dashboard">Dashboard</NavLink>
                        
                    </li>
                </AuthorizeView>
                <AuthorizeView>
                    <Authorized>
                        <button class="btn btn-primary me-2" @onclick="OpenSidebar">Ver Perfil</button>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item">
                            <NavLink class="btn btn-outline-light me-2" href="/login">Login</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink class="btn btn-outline-light" href="/register">Register</NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </ul>
        </div>
    </nav>

    <div class="container mt-4">
        @if (isSidebarOpen)
        {
            <PorfileComponent UserId="@actorUserId" IsOpen="true" OnClose="CloseSidebar" />
        }
        @Body
    </div>
    </div>
@code {
    private bool isDoctor;
    private bool isAdmin;
    private bool isPatient;
    private string? actorUserId;

    private bool isSidebarOpen = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        actorUserId = (await AuthStateProvider.GetAuthenticationStateAsync()).User.FindFirst(JwtRegisteredClaimNames.Sub)?.Value;

        var user = authState.User;
        isDoctor = user.IsInRole("Doctor");
        isAdmin = user.IsInRole("Admin");
        isPatient = user.IsInRole("Patient");
    }

    private void OpenSidebar() => isSidebarOpen = true;
    private void CloseSidebar() => isSidebarOpen = false;
}

