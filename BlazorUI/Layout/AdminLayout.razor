@using System.IdentityModel.Tokens.Jwt
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager NavigationManager



<div class="d-flex">
    <AuthorizeView Roles="Admin">
        <div class="bg-dark text-white p-3" style="width:250px; height:100vh;">
            <h4 class="mb-4" style="color:white">Panel Admin</h4>
            <nav class="nav flex-column">
                <NavLink class="nav-link text-white" href="/users">Usuarios</NavLink>
                <NavLink class="nav-link text-white" href="/admin/dashboard">Citas</NavLink>
                <NavLink class="nav-link text-white" href="/">Home</NavLink>
            </nav>
        </div>
    </AuthorizeView>

    <div class="flex-grow-1 d-flex flex-column">
        <nav class="d-flex navbar-light bg-light px-3">
            <span class="navbar-brand">Administrador</span>
            <div class="ms-auto">
                <AuthorizeView>
                    <Authorized>
                        
                        <button class="btn btn-outline-danger" @onclick="Logout">Logout</button>
                        <button class="btn btn-primary me-2" @onclick="OpenSidebar">Ver Perfil</button>
                    </Authorized>
                </AuthorizeView>
            </div>
        </nav>

        <div class="p-4 flex-grow-1">
            @if (isSidebarOpen)
            {
                <PorfileComponent UserId="@actorUserId" IsOpen="true" OnClose="CloseSidebar" />
            }
            @Body
        </div>
    </div>
</div>


@code {
    private bool isDoctor;
    private bool isAdmin;
    private bool isPatient;
    private string? actorUserId;

    private bool isSidebarOpen = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        actorUserId = (await AuthStateProvider.GetAuthenticationStateAsync()).User.FindFirst(JwtRegisteredClaimNames.Sub)?.Value;

        var user = authState.User;
        isDoctor = user.IsInRole("Doctor");
        isAdmin = user.IsInRole("Admin");
        isPatient = user.IsInRole("Patient");
    }

    private void OpenSidebar() => isSidebarOpen = true;
    private void CloseSidebar() => isSidebarOpen = false;

    private async Task Logout()
    {
        NavigationManager.NavigateTo("/logout");
    }
}