@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@layout MainLayout

<PageTitle>Home</PageTitle>

<div class="container mt-5">
    
        <div class="text-center mb-4">
            <h1 class="app-title">Bienvenidos a MisCITAS</h1>
            <p class="app-lead">Tu salud y bienestar, nuestra prioridad.</p>
        </div>
    <div class="blue-section shadow-lg p-4 mb-5">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="app-subtitle text-light">Sobre nosotros</h1>
                <p>
                    Somos una sucursal dedicada a brindar servicios médicos de calidad,
                    con atención personalizada y tecnología moderna para el cuidado de tu salud.
                </p>
            </div>
            <div class="col-md-6 text-center">
                <!-- Simulación de imagen bonita -->
                <div class="image-placeholder">
                    <span>Imagen de misión</span>
                </div>
            </div>
        </div>
        <div class="text-center mt-5">
            <p>Agenda una cita con nosotros.</p>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-12">
            <div class="bg-light shadow-lg rounded p-5 text-center">
                <h2 class="fs-2 fw-bold text-primary mb-4">Nuestra historia</h2>
                <p class="fs-5 text-muted">
                    Desde nuestros inicios hemos trabajado para construir un espacio seguro y profesional.
                    Con más de 10 años de experiencia, seguimos creciendo junto a nuestra comunidad.
                </p>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-12 text-center mb-4">
            <h2 class="fs-2 fw-bold text-primary">Nuestro equipo</h2>
            <p class="text-muted">Conoce a nuestros especialistas y cómo pueden ayudarte.</p>
        </div>

        <!-- Card 1 Example-->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm h-100">
                <img src="doctor.jpg" class="card-img-top fixed-img" alt="Doctor">
                <div class="card-body text-center">
                    <h5 class="card-title">Doctor</h5>
                    <p class="card-text">
                        Atención general, diagnóstico y seguimiento de tu salud.
                    </p>
                </div>
            </div>
        </div>

        <!-- Card 2 Example-->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm h-100">
                <img src="dentis.jpg" class="card-img-top fixed-img" alt="Dentista">
                <div class="card-body text-center">
                    <h5 class="card-title">Dentista</h5>
                    <p class="card-text">
                        Cuidado de tu salud bucal, limpiezas y tratamientos dentales.
                    </p>
                </div>
            </div>
        </div>

        <!-- Card 3 Example-->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm h-100">
                <img src="pediatrician.jpg" class="card-img-top fixed-img" alt="Pediatra">
                <div class="card-body text-center">
                    <h5 class="card-title">Pediatra</h5>
                    <p class="card-text">
                        Especialista en la salud y desarrollo de los niños.
                    </p>
                </div>
            </div>
        </div>

        <!-- Card 4 Example-->
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm h-100">
                <img src="cardiologist.jpg" class="card-img-top fixed-img" alt="Cardiólogo">
                <div class="card-body text-center">
                    <h5 class="card-title">Cardiólogo</h5>
                    <p class="card-text">
                        Prevención y tratamiento de enfermedades del corazón.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-12 text-center">
            <h2 class="fs-2 fw-bold text-primary mb-4">Ubicación</h2>
            <p class="text-muted mb-4">
                Nos encontramos en el corazón de la ciudad, con fácil acceso y estacionamiento disponible.
            </p>

            <div class="card shadow-lg border-0 mx-auto" style="max-width: 700px;">
                <div class="card-body">
                    <h5 class="card-title fw-bold">Dirección</h5>
                    <p class="card-text mb-4">Av. Principal #123, Santiago, Nuevo León</p>

                    <!-- Google Maps iframe más pequeño y responsivo -->
                    <div class="ratio ratio-4x3">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4424.540982006835!2d-100.3157294239348!3d25.677346012084424!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x866295870880a1bf%3A0x98385369d4141866!2sVicente%20Guerrero%20272-112%2C%20Centro%2C%2064000%20Monterrey%2C%20N.L.!5e1!3m2!1ses-419!2smx!4v1778002892916!5m2!1ses-419!2smx"
                        width="600" height="450" 
                        style="border:0;" allowfullscreen="" loading="lazy" 
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <AuthorizeView>
            <Authorized>
                <h1 class="text-primary mb-4">Agenda un Cita</h1>
                <NavLink class="btn btn-primary btn-lg" href="/cliente/miscitas">Agendar cita</NavLink>
            </Authorized>
            <NotAuthorized>
                <h1 class="text-primary mb-4">Registrate para poder agender una Cita</h1>
                <NavLink class="btn btn-outline-primary btn-lg m-4" href="/login">Registrarse / Iniciar sesión para agendar</NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

