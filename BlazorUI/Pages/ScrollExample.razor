@page "/scrollexample"
<h3>ScrollExample</h3>
<head>
    
      <title>Test Scroll + Sticky</title>
     
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
    }

    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 60px;
      background: #007bff;
      color: white;
      display: flex;
      align-items: center;
      padding: 0 20px;
      z-index: 2000;
    }

    .filters-bar {
      position: sticky;
      top: 60px; /* justo debajo del navbar */
      background: #f8f9fa;
      padding: 10px;
      border-bottom: 1px solid #ccc;
      z-index: 1500;
    }

    .appointment-scroll {
      height: calc(100vh - 120px); /* pantalla menos navbar+filtros */
      overflow-y: auto;
      padding: 10px;
      background: #eee;
    }

    .card {
      background: white;
      border: 1px solid #ddd;
      margin-bottom: 10px;
      padding: 15px;
    }
  </style>
</head>
<h2 class="text-center mb-4">Ejemplo Scroll + Sticky</h2>
<div class="navbar">Navbar fijo</div>
    <div class="filters-bar">
        <input type="text" placeholder="Buscar..." />
        <select>
            <option>Todos</option>
            <option>Activos</option>
        </select>
    </div>

    <div class="appointment-scroll">
        <!-- Generamos muchos elementos para forzar scroll -->
